---
# Conservative check set: correctness/portability signal only, no stylistic
# nags (magic numbers, identifier length, etc.) which don't fit a numerics/
# CUDA codebase and would drown out real findings.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  portability-*,
  clang-analyzer-*
CheckOptions:
  # int -> float (e.g. `cost / n`, `step * dt`) is everywhere in the
  # numerics and exact for the small counts involved; keep the check for
  # integer narrowing, where a silent wrap is a real bug.
  - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: false
WarningsAsErrors: ''
HeaderFilterRegex: '(include/rmpc|examples)/.*'
ExtraArgsBefore:
  - -Wno-unknown-warning-option
